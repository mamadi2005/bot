# Copy to .env for local runs. Never commit .env.
# On Render, put these in the service's Environment tab.
# On GitHub, only RENDER_BASE_URL and TRIGGER_TOKEN go in Repository Secrets.

TELEGRAM_BOT_TOKEN=
# Up to three Gemini keys; on 429/quota the bot rotates to the next one.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Legacy single key (still works if you only have one)
GEMINI_API_KEY=

# --- Webhook (Render) -------------------------------------------------------
# Telegram secret token; also accepted as the path suffix /webhook/<secret>.
# Render can generate one: leave empty to disable path/header checks locally.
WEBHOOK_SECRET=
# Bearer token that GitHub Actions sends to POST /trigger_news. Required there.
TRIGGER_TOKEN=
# Public HTTPS URL of this deployment, e.g. https://my-bot.onrender.com
PUBLIC_BASE_URL=

# --- Storage ----------------------------------------------------------------
# SQLite file. On Render use the mounted disk, e.g. /var/data/bot.db
DB_PATH=data/bot.db
# Optional managed Postgres instead of SQLite (takes precedence over DB_PATH)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# --- Delivery ---------------------------------------------------------------
# Permanent recipients (comma-separated numeric ids and/or @channels).
# They receive everything and are never gated by channel membership.
TELEGRAM_CHAT_IDS=
# Optional: receives run reports and error alerts.
ADMIN_CHAT_ID=
# Seconds between two different recipients (Telegram allows ~30 msg/s).
BROADCAST_DELAY=0.05
# In-process scheduler on the Render web process (00/08/12/16/20 Tehran).
SCHEDULER_ENABLED=true
# News messages are deleted after this many hours.
NEWS_TTL_HOURS=24

# Optional GitHub API token for higher search limits; local runs do not require it.
GITHUB_TOKEN=

# Optional tuning
GEMINI_MODEL=gemini-2.5-flash
ENABLE_PDF=false
DRY_RUN=false
DEBUG=false
# Anti-spam: max 3 messages per 60s, then muted for 5 minutes
USER_RATE_WINDOW_SECONDS=60
USER_RATE_MAX_MESSAGES=3
USER_MUTE_SECONDS=300
# /stats counts users seen within this many days
STATS_ACTIVE_DAYS=30
