# Copy to .env for local runs. Never commit .env.
# On GitHub, put every value below in Repository Secrets (Settings > Secrets and variables > Actions).

TELEGRAM_BOT_TOKEN=
# Up to three Gemini keys; on 429/quota the bot rotates to the next one.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Legacy single key (still works if you only have one)
GEMINI_API_KEY=

# Who receives every digest. Comma-separated numeric chat ids and/or @channel usernames.
# Send /start to the bot to learn your numeric chat id.
TELEGRAM_CHAT_IDS=

# Optional: fallback recipient + target for error digests
ADMIN_CHAT_ID=

# Filled automatically by GitHub Actions; for local runs use a personal token.
GITHUB_TOKEN=

# Optional tuning
GEMINI_MODEL=gemini-2.5-flash
ENABLE_PDF=false
DRY_RUN=false
DEBUG=false
# Anti-spam: max 3 messages per 60s, then muted for 5 minutes
USER_RATE_WINDOW_SECONDS=60
USER_RATE_MAX_MESSAGES=3
USER_MUTE_SECONDS=300
# /stats counts users seen within this many days
STATS_ACTIVE_DAYS=30
