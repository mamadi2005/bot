# Copy to .env for local runs. Never commit .env.
# On GitHub, put every value below in Repository Secrets (Settings > Secrets and variables > Actions).

TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=

# Who receives every digest. Comma-separated numeric chat ids and/or @channel usernames.
# Send /start to the bot to learn your numeric chat id.
TELEGRAM_CHAT_IDS=

# Optional: fallback recipient + target for error digests
ADMIN_CHAT_ID=

# Filled automatically by GitHub Actions; for local runs use a personal token.
GITHUB_TOKEN=

# Optional tuning
GEMINI_MODEL=gemini-2.5-flash
ENABLE_PDF=false
DRY_RUN=false
DEBUG=false
